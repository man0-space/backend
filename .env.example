# HTTP API and allowed app origins
PORT=3005
API_BASE_URL=https://api.man0.space
APP_ORIGINS=http://localhost:4001

# Generate a fresh 32-byte hex SESSION_KEY for this environment.
SESSION_KEY=

# Dedicated Neon databases and Valkey connections
USER_DATABASE_URL=
WORKFLOW_DATABASE_URL=
VALKEY_CACHE_SERVICE_URI=
VALKEY_COMPOSER_SERVICE_URI=

# NEAR and Compose. Use your own funded test accounts.
NEAR_NETWORK=testnet
NEAR_MAINNET_RPC=https://rpc.mainnet.near.org
NEAR_TESTNET_RPC=https://rpc.testnet.near.org
MAN0_TREASURY_ADDRESS=
MAN0_TESTNET_TREASURY_ADDRESS=
NEAR_DEPLOYER_PRIVATE_KEY=
NEAR_DEPLOYER_TESTNET_PRIVATE_KEY=
NEAR_FACILITATOR_KEY=
COMPOSE_API_URL=
FACTORY_ADDRESS=
WORKFLOW_ADDRESS=
REPUTATION_ADDRESS=
VALIDATION_ADDRESS=

# Vibe, media, cards and execution-proof storage
NEBIUS_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
PINATA_JWT=
PINATA_GATEWAY_URL=

# Optional email sign-in. OAuth providers use auth/config.ts's names.
RESEND_API_KEY=
EMAIL_FROM=auth@man0.space
